@model HistorialAcademico.Web.Controllers.CompararViewModel
@{
    ViewData["Title"] = "Comparar escenarios";
    ViewData["Pestana"] = "comparar";
    var ctx = Model.Estado.Contexto;
    var periodos = Model.Escenarios
        .SelectMany(e => e.Evaluacion.Periodos.Where(p => p.Materias.Count > 0).Select(p => p.Periodo))
        .Distinct().OrderBy(p => p).ToList();
}

<h1 class="h3 mb-3">Planificador de cuatrimestres</h1>
<partial name="_Pestanas" />

@if (ctx is null)
{
    <div class="alert alert-info">@Model.Estado.NoPuedePlanificar</div>
    return;
}

@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success" role="status">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

<h2 class="h5">Comparar escenarios</h2>
<p class="text-muted">
    Todos los escenarios evaluados con las mismas reglas (límite de @ctx.Limite créditos). Abre uno para editarlo.
    Marca como <strong>plan activo</strong> el que decidas seguir: la fecha de graduación del inicio sale de él.
</p>
@if (Model.Escenarios.Count < 2)
{
    <div class="alert alert-info py-2 small" id="pocos-escenarios">
        Solo hay un escenario. Para comparar, en la pestaña «Plan por cuatrimestres» usa «Gestionar escenarios → Guardar como…» y cambia la copia
        (por ejemplo, una con menos carga).
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="min-width:14rem"></th>
                    @foreach (var (plan, _) in Model.Escenarios)
                    {
                        <th class="text-center columna-escenario @(plan.Activo ? "escenario-activo" : "")" data-plan="@plan.Id">
                            <a asp-action="Index" asp-route-id="@plan.Id">@plan.Nombre</a>
                            @if (plan.Activo) { <div><span class="badge bg-success">Plan activo</span></div> }
                            <form asp-action="Activar" method="post" class="mt-1">
                                <input type="hidden" name="id" value="@plan.Id" />
                                <input type="hidden" name="desde" value="comparar" />
                                <button type="submit" class="btn btn-sm @(plan.Activo ? "btn-outline-secondary" : "btn-outline-primary")">@(plan.Activo ? "Quitar de activo" : "Marcar como activo")</button>
                            </form>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">Cuatrimestres planificados</th>
                    @foreach (var (_, ev) in Model.Escenarios) { <td class="text-center fs-5">@ev.CuatrimestresPlanificados</td> }
                </tr>
                <tr>
                    <th scope="row">Período de graduación</th>
                    @foreach (var (_, ev) in Model.Escenarios)
                    {
                        <td class="text-center fs-5">
                            @(ev.Graduacion?.Nombre ?? "—")
                            @if (ev.GraduacionEstimada) { <div class="small text-muted">estimada</div> }
                        </td>
                    }
                </tr>
                <tr id="fila-promedio">
                    <th scope="row">Créditos promedio por período</th>
                    @foreach (var (_, ev) in Model.Escenarios)
                    {
                        <td class="text-center">@(ev.PeriodoMasPesado is null ? "—" : ev.PromedioCreditos.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))</td>
                    }
                </tr>
                <tr id="fila-mas-pesado">
                    <th scope="row">Período más pesado</th>
                    @foreach (var (_, ev) in Model.Escenarios)
                    {
                        <td class="text-center">
                            @if (ev.PeriodoMasPesado is { } pesado)
                            {
                                <span>@pesado.Periodo.Nombre</span> <span class="small text-muted">(@pesado.Creditos cr)</span>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                    }
                </tr>
                <tr>
                    <th scope="row">Créditos sin planificar</th>
                    @foreach (var (_, ev) in Model.Escenarios)
                    {
                        <td class="text-center @(ev.CreditosSinPlanificar > 0 ? "text-warning" : "text-success")">@ev.CreditosSinPlanificar (@ev.SinPlanificar.Count materias)</td>
                    }
                </tr>
                <tr>
                    <th scope="row">Estado del plan</th>
                    @foreach (var (_, ev) in Model.Escenarios)
                    {
                        <td class="text-center">
                            @if (ev.Problemas == 0) { <span class="badge bg-success">Sin problemas</span> }
                            else { <span class="badge bg-danger">@ev.Problemas problema@(ev.Problemas == 1 ? "" : "s")</span> }
                        </td>
                    }
                </tr>
                @foreach (var per in periodos)
                {
                    <tr>
                        <th scope="row" class="fw-normal text-muted">Créditos en @per.Nombre</th>
                        @foreach (var (_, ev) in Model.Escenarios)
                        {
                            var p = ev.Periodos.FirstOrDefault(x => x.Periodo == per && x.Materias.Count > 0);
                            <td class="text-center">
                                @if (p is null) { <span class="text-muted">—</span> }
                                else { <span class="@(p.SobreLimite ? "text-danger fw-semibold" : "")">@p.Creditos</span> }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
